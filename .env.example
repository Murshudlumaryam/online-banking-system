# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in real values. Never commit the real .env.
# ---------------------------------------------------------------------------

# --- PostgreSQL ---
POSTGRES_USER=banking_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=banking_db
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Backend ---
BACKEND_PORT=8000
DATABASE_URL=postgresql+asyncpg://banking_user:change_me@db:5432/banking_db
REDIS_URL=redis://redis:6379/0

# JWT / security
JWT_SECRET_KEY=change_me_super_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
# Which channel carries the transfer-confirmation OTP: email | sms | both.
# "email" only needs EMAIL_BACKEND=smtp + real SMTP credentials below to
# actually reach an inbox — no paid SMS provider required.
OTP_DELIVERY_CHANNEL=email

# Field-level encryption at rest (Phase 9) — encrypts 2FA (TOTP) secrets
# before they reach the database. Generate a real one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required (app refuses to start without a valid one) when ENVIRONMENT=production.
ENCRYPTION_KEY=

# Observability — exposes GET /metrics in Prometheus text format.
METRICS_ENABLED=true

# Rate limiting (requests per 60-second window per client IP)
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_MINUTE=5
RATE_LIMIT_PASSWORD_RESET_PER_MINUTE=3
RATE_LIMIT_TRANSFER_PER_MINUTE=20
RATE_LIMIT_DEFAULT_PER_MINUTE=120

# Email (Phase 7) — "console" logs only (safe default), "smtp" sends for real
EMAIL_BACKEND=console
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_ADDRESS=no-reply@example-bank.internal

# SMS (Phase 8) — "console" logs only (safe default), "twilio" sends for real
SMS_BACKEND=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_API_BASE_URL=https://api.twilio.com

# --- Frontend ---
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api/v1

# --- Misc ---
ENVIRONMENT=development
# Only set to true if a reverse proxy in front of this app is guaranteed
# to overwrite (not just append to) any client-supplied X-Forwarded-For.
TRUST_PROXY_HEADERS=false
