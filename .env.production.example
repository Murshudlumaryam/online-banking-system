# ---------------------------------------------------------------------------
# Copy this file to ".env" on the VM (next to docker-compose.prod.yml) and
# fill in real values. Never commit the real .env to git.
#
# Generate strong random secrets with, e.g.:
#   openssl rand -base64 32
# ---------------------------------------------------------------------------

# --- Domain (required for Caddy to get a real HTTPS certificate) ---
# Must be a real domain whose DNS A record already points at this VM's
# public IP before you start the stack — see DEPLOYMENT.md.
DOMAIN_NAME=bank.example.com

# --- PostgreSQL ---
POSTGRES_USER=banking_user
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_RANDOM_VALUE
POSTGRES_DB=banking_db

# --- JWT / security ---
JWT_SECRET_KEY=REPLACE_WITH_A_STRONG_RANDOM_VALUE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5

# --- Field-level encryption at rest (Phase 9) ---
# Encrypts 2FA (TOTP) secrets before they reach the database. REQUIRED —
# the app refuses to start in production without a valid Fernet key here.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Treat this exactly like JWT_SECRET_KEY/POSTGRES_PASSWORD: a real secret,
# never committed, and — once this matters for more than one VM — a good
# first candidate to move into Vault/AWS Secrets Manager/GCP Secret Manager
# (see backend/app/core/secrets_provider.py for the integration seam).
# Losing this key permanently locks out every customer who enrolled in 2FA
# (their stored secret becomes undecryptable) — back it up as carefully as
# the database itself.
ENCRYPTION_KEY=REPLACE_WITH_A_GENERATED_FERNET_KEY

# --- Observability ---
# Exposes GET /metrics in Prometheus text format. Safe to leave on — no
# secrets or PII in the exported metrics — but you can disable it if this
# VM has no Prometheus scraping it.
METRICS_ENABLED=true

# --- Rate limiting (production always uses the Redis backend — see
# docker-compose.prod.yml, which sets RATE_LIMIT_BACKEND=redis directly) ---
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_MINUTE=5
RATE_LIMIT_PASSWORD_RESET_PER_MINUTE=3
RATE_LIMIT_TRANSFER_PER_MINUTE=20
RATE_LIMIT_DEFAULT_PER_MINUTE=120

# --- Email — leave EMAIL_BACKEND=console until you have real SMTP
# credentials; console mode logs instead of sending, which is safe but
# means customers never actually receive OTP/reset emails. ---
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_ADDRESS=no-reply@bank.example.com

# --- SMS — same rule: leave SMS_BACKEND=console until you have a real
# Twilio account. ---
SMS_BACKEND=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_API_BASE_URL=https://api.twilio.com

# --- Frontend build-time value (baked into the static bundle) ---
# Using a same-origin path (proxied by Caddy) avoids CORS entirely and is
# the recommended default — only change this if the API is genuinely on a
# different domain.
VITE_API_BASE_URL=/api/v1

# Only needed if you point VITE_API_BASE_URL at a genuinely different
# domain than the one Caddy serves the frontend from (uncommon — the
# default same-origin proxy setup above never triggers CORS at all).
# CORS_ALLOW_ORIGINS=["https://bank.example.com"]

# --- Misc ---
ENVIRONMENT=production
